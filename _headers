# Security headers for every page, applied by Netlify.
# The Content-Security-Policy tells browsers to block anything not listed here:
# no outside scripts, no tracking pixels, no data sent anywhere except our own signup form.
# Every allowed outside address is explained in PRIVACY-AUDIT.md. Keep the two in sync.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
